# Copiar a .env y completar. El .env real NO se versiona.
# El compose toma estos valores; los secretos de cada servicio viven en
# gotrue.env, postgrest.env, storage.env y funciones.env.

# Nombre del stack y prefijo de contenedores.
# En QA y PRD puede ser el mismo porque son servidores distintos.
STACK=misociopyme
APP=misociopyme

# Clave del superusuario postgres del contenedor. Solo se usa al inicializar.
# Generar con: openssl rand -hex 24
CLAVE_SUPER=CAMBIAR

# Puertos publicados SOLO en 127.0.0.1 (nginx entra por ahi).
PUERTO_GOTRUE=9999
PUERTO_POSTGREST=3010
PUERTO_POSTGREST_ADMIN=3011
PUERTO_STORAGE=5000
PUERTO_FN=3012
