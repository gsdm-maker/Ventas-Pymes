# Supabase (proyecto cloud). Copia este archivo a .env.local y completa los valores.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# WhatsApp de ventas para los botones «Subir de plan» (solo dígitos, con código de país, ej. 569XXXXXXXX).
# Si queda vacío, la app muestra el aviso sin botón.
VITE_WHATSAPP_VENTAS=
