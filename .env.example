# PostgreSQL (API propia: PostgREST + auth). Copia este archivo a .env.local y completa los valores.
VITE_PG_URL=https://pg-qa.gsdm.cl
VITE_PG_KEY=pg-qa

# WhatsApp de ventas para los botones «Subir de plan» (solo dígitos, con código de país, ej. 569XXXXXXXX).
